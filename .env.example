# Copy this file to .env and fill in the values you need.
# .env is gitignored. Never commit a real API key.

# Which model host to use: groq (free hosted API) or ollama (local).
AGENT_PROVIDER=groq

# Groq free API key: https://console.groq.com/keys
# No credit card is required for the free tier.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama runs on your machine and does not need a key.
# Pull a tool-capable model first, for example: ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# Agent loop limits.
AGENT_MAX_STEPS=8
AGENT_TEMPERATURE=0.2
AGENT_LLM_TIMEOUT=120
